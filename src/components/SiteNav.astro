---
const links = [['首页','/'],['好玩宇宙','/games/'],['普莱 AI Agent','/studio/'],['NewCoin','/newcoin/'],['合作','/cooperation/'],['关于','/about/'],['付款演示','/payment/']];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="bar">
    <a href="/" class="brand" aria-label="NewPlay 首页"><img src="/assets/newplay-logo.svg" width="116" height="30" alt="NewPlay" /></a>
    <nav aria-label="主导航" class="desktop-nav">
      {links.map(([label, url]) => <a href={url} aria-current={url === path ? 'page' : undefined}>{label}</a>)}
      <a class="brand-replay" href="/?intro=replay" aria-label="回到首页，重播品牌开场">品牌标识</a>
    </nav>
    <details class="mobile-nav"><summary aria-label="导航菜单"><span></span><span></span></summary>
      <nav aria-label="手机导航">{links.map(([label,url]) => <a href={url} aria-current={url === path ? 'page' : undefined}>{label}</a>)}<a href="/?intro=replay">重播品牌开场</a></nav>
    </details>
  </div>
</header>
<style>
  .site-header{position:relative;z-index:8;background:#d5e7fe;color:#12234c}
  .bar{max-width:1440px;padding:0 clamp(24px,6.95vw,100px);min-height:94px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .brand,.brand img{display:block}.brand{padding:8px 0}.brand img{width:142px;height:auto}
  nav{display:flex;align-items:center;gap:20px}nav a{text-decoration:none;font-size:14px;font-weight:700;padding:10px 0;white-space:nowrap}
  nav a[aria-current],nav a:hover{color:#234bff;text-decoration:underline;text-underline-offset:5px}
  nav .brand-replay{border:1px solid #b5c8e7;background:#f8fbff;font-size:11px;font-weight:500;padding:8px 11px;border-radius:20px}
  .mobile-nav{display:none}summary{cursor:pointer;list-style:none;border:1px solid #9ab7dc;border-radius:8px;width:40px;height:40px;align-items:center;justify-content:center;gap:5px;flex-direction:column}
  summary::-webkit-details-marker{display:none}summary span{width:17px;height:2px;background:currentColor}
  @media(max-width:850px){.bar{min-height:76px;padding-inline:24px}.brand img{width:120px}.desktop-nav{display:none}.mobile-nav{display:block}summary{display:flex}.mobile-nav nav{position:absolute;top:100%;left:0;right:0;display:grid;background:#d5e7fe;gap:0;padding:0 24px 20px;box-shadow:0 14px 20px #12234c19}.mobile-nav nav a{border-top:1px solid #bdd4f2}}
</style>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach(menu => {
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
    });
    document.addEventListener('click', event => { if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
  });
</script>
