---
import OfficialLinks from '../OfficialLinks.astro';
const navs=[
  ['产品与体验',[['小游戏','/games/'],['AI 工作室','/studio/'],['NewCoin','/newcoin/']]],
  ['一起创造',[['游戏开发者','/cooperation/?role=game'],['创作者与内容','/cooperation/?role=creator'],['技术与体验合作','/cooperation/?role=tech'],['NewPay 合作','/cooperation/?role=payment']]],
  ['认识我们',[['关于 NewPlay','/about/'],['认识普莱','/about/#plai'],['产品方向','/about/#directions']]]
] as const;
---
<footer class="home-footer"><div class="rail"><div class="footer-grid"><div class="footer-intro"><a href="/" aria-label="NewPlay 首页"><img src="/assets/home/c80be.svg" width="142" height="42" alt="NewPlay"/></a><h3>NewPlay, Play New.</h3><p>面向东盟年轻人的数字娱乐新空间。<br/>从小游戏开始，发现更多好玩。</p><a href="/games/">发现你的下一份好玩 ↗</a><OfficialLinks/></div>
{navs.map(([title,links])=><nav aria-label={title}><h3>{title}</h3>{links.map(([label,url])=><a href={url}>{label==='NewCoin'&&<img src="/assets/home/579ac.svg" alt=""/>}{label}</a>)}</nav>)}</div>
<div class="footer-fine"><span>© 2026 NewPlay. Play New.</span><a href="/information/#terms">使用与权益提示</a><a href="/information/#privacy">数据与隐私说明</a></div><p class="fineprint">品牌概念视觉 · 游戏、Agent 与创作画面用于表达产品方向，不代表已上线功能。</p></div></footer>
