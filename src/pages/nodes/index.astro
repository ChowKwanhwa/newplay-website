---
import BusinessPage from "../../components/business/BusinessPage.astro";
---

<BusinessPage
  standalone
  title="PLAI 启航节点计划"
  description="先和普莱打个招呼，再一起了解启航节点套组和参与说明。"
>
  <div class="node-page">
    <header class="biz-simple-header">
      <a href="/"><img src="/assets/newplay-logo.svg" alt="NewPlay 首页" /></a
      ><a href="/#team">认识普莱小队 ↗</a>
    </header>
    <section class="quiz biz-wrap" data-quiz>
      <div class="art">
        <span class="sticker">一起，玩点大的。</span><img
          src="/assets/plai-intro-transparent.png"
          alt="普莱向你伸出手，邀请你一起加入小队"
        /><b class="seal">PLAI<br />CREW</b>
      </div>
      <div class="questions">
        <p class="biz-overline">PLAI 节点计划 · 登场问答</p>
        <div class="steps" aria-label="问题进度">
          <span aria-current="step">1</span><span>2</span>
        </div>
        <h1 data-question tabindex="-1">你确定<br />要加入我吗？</h1><p
          data-explain
        >
          先和普莱打个招呼，<br />再一起了解节点计划。
        </p>
        <div class="answers">
          {
            ["不确定", "确定", "非常确定"].map((text, i) => (
              <button type="button" data-answer={i}>
                <>
                  <b>{["A", "B", "C"][i]}</b>
                  <span>{text}</span>
                </>
              </button>
            ))
          }
        </div>
        <p class="biz-note" data-note>每一份好奇，都值得认真选择。</p>
      </div>
    </section>
    <section id="packages" class="packages biz-wrap" data-package hidden>
      <p class="biz-overline">PLAI 启航节点计划</p><h1 tabindex="-1">
        和普莱一起，<br />组成共建小队。
      </h1><p class="biz-lead">
        从游戏体验，到 AI 音乐与内容共创。<br
        />找到同伴，把好玩的想法一起做出来。
      </p>
      <div class="package-grid">
        <div class="package-art">
          <img src="/assets/plai-intro-transparent.png" alt="普莱小队" /><div
            class="seat-ticket"
          >
            <strong>1 + 3</strong><b>一席领航 · 三席共建</b>
          </div>
        </div>
        <div class="package-copy">
          <p class="biz-note">PLAI 节点套组</p><h2>一起启航</h2><p
            class="price"
          >
            $5,000 <small>/ 套</small>
          </p><p class="biz-note">
            套餐参考价为美元，结算币种与实付金额以有效订单报价为准。
          </p>
          <div class="roles">
            <div><b>领航席 × 1</b><p>发起工作室，组织共创</p></div><div>
              <b>共建席 × 3</b><p>参与创作、交流与社群活动</p>
            </div>
          </div>
          <ul>
            <li>一起探索游戏与 Agent 体验</li><li>
              参与 AI 音乐、内容与作品共创
            </li><li>连接创作者、玩家与社群伙伴</li>
          </ul>
          <label
            ><input type="checkbox" data-agree /> 我已了解节点计划与参与说明。</label
          ><button class="biz-btn" data-checkout disabled
            >确认套餐，前往付款 <span aria-hidden="true">↗</span></button
          >
          <p class="biz-note" data-hint>请先阅读下方参与说明，再确认套餐。</p>
        </div>
      </div><div class="terms">
        <h2>参与之前，先了解清楚。</h2><p>
          节点服务按产品计划开放。发行规模、代理制度、权益细则与奖励规则以正式发布内容为准。项目不承诺保本、收益或升值。
        </p><p class="biz-note">
          当前为前端交互预览，不接收资金、不创建真实订单。
        </p>
      </div>
    </section>
    <footer class="biz-simple-footer">
      <span>NewPlay, Play New.</span><a href="/games/">返回好玩宇宙 ↗</a>
    </footer>
    <dialog class="biz-dialog">
      <h2>我觉得你应该<br />还要好好想想</h2><form method="dialog">
        <button class="biz-btn">再想一想</button>
      </form>
    </dialog>
  </div>
</BusinessPage>
<style>
  .node-page {
    background: #edf3ff;
    min-height: 100vh;
    color: #10214b;
  }
  .quiz {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 4.2%;
    align-items: center;
    padding: 65px 0 105px;
  }
  .art {
    aspect-ratio: 604/660;
    position: relative;
    background: #234bff;
    border-radius: 42%;
    isolation: isolate;
  }
  .art img {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 89%;
    object-fit: contain;
  }
  .sticker,
  .seal {
    position: absolute;
    background: #ffdf58;
    font-weight: 900;
  }
  .sticker {
    left: 16%;
    top: 12%;
    padding: 5px 14px 34px;
    border-radius: 9px;
  }
  .seal {
    border-radius: 50%;
    width: 20%;
    aspect-ratio: 1;
    display: grid;
    align-content: center;
    text-align: center;
    right: 2%;
    bottom: 3%;
    line-height: 1.05;
    font:
      900 19px/1.05 "NewPlay Space",
      sans-serif;
  }
  .steps {
    display: flex;
    gap: 68px;
    margin: 24px 0;
  }
  .steps span {
    display: inline-grid;
    place-items: center;
    border: 1px solid #8097bf;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    font-size: 13px;
  }
  .steps [aria-current] {
    color: white;
    background: #234bff;
    border-color: #234bff;
  }
  .node-page h1 {
    font-size: clamp(2.8rem, 4.4vw, 63px);
    line-height: 1.2;
    letter-spacing: -0.055em;
    font-weight: 900;
    margin: 18px 0;
  }
  .questions > p:not(.biz-overline) {
    line-height: 1.8;
  }
  .answers {
    display: grid;
    gap: 12px;
    margin: 28px 0 20px;
  }
  .answers button {
    display: flex;
    align-items: center;
    gap: 18px;
    text-align: left;
    border: 1px solid #bdcdef;
    border-radius: 13px;
    min-height: 64px;
    padding: 8px 19px;
    background: white;
    font-size: 17px;
  }
  .answers button:hover {
    border-color: #234bff;
  }
  .answers b {
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: #e7edff;
    width: 32px;
    height: 32px;
    font-weight: 900;
  }
  .packages {
    padding: 55px 0;
  }
  .package-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.2%;
    align-items: center;
    margin: 36px 0 40px;
  }
  .package-art {
    position: relative;
    overflow: hidden;
    aspect-ratio: 600/650;
    background: #234bff;
    border-radius: 34px;
  }
  .package-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 95%;
    object-fit: contain;
  }
  .seat-ticket {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 1%;
    height: 22%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 16px 24px;
    background: #ffdf58;
    color: #10214b;
    border-radius: 18px;
  }
  .seat-ticket strong {
    font:
      700 clamp(32px, 3.8vw, 54px) / 1.1 "NewPlay Space",
      sans-serif;
    letter-spacing: -0.05em;
  }
  .seat-ticket b {
    font-size: 14px;
  }
  .package-copy {
    padding: 36px;
    border: 1px solid #c8d6f0;
    background: white;
    border-radius: 24px;
  }
  .package-copy h2 {
    font-size: 34px;
    margin: 8px 0;
  }
  .package-copy .price {
    font:
      700 clamp(52px, 5.3vw, 76px) / 1.25 "NewPlay Space",
      sans-serif;
    letter-spacing: -0.065em;
    margin: 12px 0;
  }
  .package-copy small {
    font:
      700 15px "NewPlay Noto SC",
      sans-serif;
    letter-spacing: normal;
  }
  .roles {
    margin: 38px 0;
    display: grid;
    gap: 18px;
  }
  .roles b,
  .roles p {
    font-size: 15px;
    font-weight: 800;
  }
  .package-copy ul {
    font-size: 13px;
    line-height: 2.2;
    list-style: none;
    padding-left: 18px;
  }
  .package-copy label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 22px 0;
    font-size: 13px;
  }
  .package-copy .biz-btn {
    width: 100%;
    justify-content: space-between;
    min-height: 63px;
    background: #234bff;
    margin-bottom: 10px;
  }
  .package-copy .biz-btn:disabled {
    color: white !important;
    background: #8ca2ff;
  }
  .terms {
    padding: 30px;
    background: #dce8ff;
    border-radius: 20px;
  }
  .terms p {
    margin-top: 10px;
  }
  @media (min-width: 1250px) {
    .node-page {
      min-height: max(100vh, 1100px);
    }
  }
  @media (max-width: 760px) {
    .quiz {
      display: block;
      padding: 15px 0 35px;
    }
    .art {
      aspect-ratio: 342/314;
      border-radius: 34px;
    }
    .art img {
      height: 98%;
    }
    .sticker {
      left: 5%;
      top: 8%;
    }
    .seal {
      width: 24%;
      font-size: 15px;
    }
    .questions {
      margin-top: 29px;
    }
    .node-page h1 {
      font-size: clamp(38px, 10.5vw, 52px);
    }
    .answers {
      margin-top: 22px;
    }
    .biz-simple-footer {
      align-items: start;
      flex-direction: column;
      gap: 24px;
    }
    .package-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      margin: 24px 0 30px;
    }
    .package-art {
      aspect-ratio: 342/330;
      border-radius: 22px;
    }
    .seat-ticket {
      height: 30%;
    }
    .package-copy {
      padding: 23px;
    }
    .packages {
      padding: 30px 0;
    }
    .roles {
      grid-template-columns: 1fr;
    }
  }
</style>
<script>
  const quiz = document.querySelector<HTMLElement>("[data-quiz]")!,
    pkg = document.querySelector<HTMLElement>("[data-package]")!;
  const question = document.querySelector<HTMLElement>("[data-question]")!,
    dialog = document.querySelector("dialog")!;
  const agree = document.querySelector<HTMLInputElement>("[data-agree]")!,
    checkout = document.querySelector<HTMLButtonElement>("[data-checkout]")!;
  let step = 1;
  function showPackage() {
    quiz.hidden = true;
    pkg.hidden = false;
    pkg.querySelector("h1")!.focus();
    window.scrollTo(0, 0);
  }
  function syncLocation() {
    if (location.hash === "#packages") {
      showPackage();
      return;
    }
    if (!pkg.hidden) location.reload();
  }
  syncLocation();
  window.addEventListener("hashchange", syncLocation);
  document
    .querySelectorAll<HTMLButtonElement>("[data-answer]")
    .forEach((b, i) =>
      b.addEventListener("click", () => {
        if (i !== 2) {
          dialog.showModal();
          return;
        }
        if (step === 2) {
          showPackage();
          history.replaceState(null, "", "#packages");
          return;
        }
        step = 2;
        question.innerHTML = "那我<br>叫什么名字呢？";
        question.focus();
        document.querySelector("[data-explain]")!.innerHTML =
          "认出你的搭子，<br>我们就一起去看节点套餐。";
        document.querySelector("[data-note]")!.textContent =
          "选出普莱的名字，就能查看套餐。";
        document.querySelectorAll(".steps span").forEach((s, i) => {
          if (i === 1) s.setAttribute("aria-current", "step");
          else s.removeAttribute("aria-current");
        });
        document
          .querySelectorAll(".answers button span")
          .forEach((s, i) => (s.textContent = ["不来", "爱来不来", "普莱"][i]));
      }),
    );
  agree.addEventListener("change", () => {
    checkout.disabled = !agree.checked;
    document.querySelector("[data-hint]")!.textContent = agree.checked
      ? "进入付款演示，查看示例订单。"
      : "请先阅读下方参与说明，再确认套餐。";
  });
  checkout.addEventListener("click", () => {
    if (agree.checked) location.assign("/payment/");
  });
</script>
